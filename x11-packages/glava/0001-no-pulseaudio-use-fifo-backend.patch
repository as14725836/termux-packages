+option('disable_pulse', type: 'boolean', value: false,
+       description: 'Disable the PulseAudio audio backend (for platforms without PulseAudio, e.g. Termux/Android)')
+option('disable_fifo', type: 'boolean', value: false,
+       description: 'Disable the FIFO audio backend')
 option('enable_glfw', type: 'boolean', value: false,
        description: 'Enable legacy GLFW backend')
 option('disable_glx', type: 'boolean', value: false,
--- a/meson.build	2021-06-17 11:23:13.000000000 +0000
+++ b/meson.build	2026-10-12 04:12:50.063370130 +0000
@@ -20,14 +20,36 @@
 
 glava_dependencies = [
   dependency('threads'),
-  cc.find_library('pulse'),
-  cc.find_library('pulse-simple'),
   cc.find_library('dl'),
   cc.find_library('m'),
   cc.find_library('X11'),
   cc.find_library('Xext')
 ]
 
+# PulseAudio is optional. On platforms without it (Termux/Android) build
+# with -Ddisable_pulse=true and use the FIFO backend instead.
+if not get_option('disable_pulse')
+  glava_dependencies += [
+    cc.find_library('pulse'),
+    cc.find_library('pulse-simple'),
+  ]
+  add_project_arguments('-DGLAVA_HAVE_PULSE', language: ['cpp', 'c'])
+endif
+
+if not get_option('disable_fifo')
+  add_project_arguments('-DGLAVA_HAVE_FIFO', language: ['cpp', 'c'])
+endif
+
+# Default audio backend name (runtime-selectable with -a). When PulseAudio is
+# unavailable build with the FIFO backend as default.
+if get_option('disable_pulse')
+  default_audio_impl = 'fifo'
+else
+  default_audio_impl = 'pulseaudio'
+endif
+add_project_arguments('-DGLAVA_DEFAULT_AUDIO_IMPL="@0@"'.format(default_audio_impl),
+                      language: ['cpp', 'c'])
+
 if cc.get_id() == 'clang'
   add_project_arguments('-fblocks', language: 'c')
   glava_dependencies += cc.find_library('BlocksRuntime')
